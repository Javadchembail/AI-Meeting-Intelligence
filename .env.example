APP_NAME="AI Meeting Intelligence"
APP_VERSION="1.0.0"
DEBUG=false

# Render PostgreSQL connection string. Do not commit real credentials.
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE"

# Groq text generation
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Gemini embeddings
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Qdrant vector database
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="meeting_transcripts"

# Required only for speaker diarization. The account must be authorized for
# pyannote/speaker-diarization-community-1.
HUGGINGFACE_TOKEN=""
